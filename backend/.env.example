PORT=3000
DATABASE_URL=postgres://app:app_password@db-dev:5432/app_dev
PG_SSL=false
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
SECURE_COOKIES=false
COOKIE_SAMESITE=lax
SETUP_TOKEN=local-setup
DEV_ADMIN_ENABLED=true
DEV_ADMIN_EMAIL=admin@test.local
DEV_ADMIN_PASSWORD=admin
FIRST_ADMIN_EMAIL=admin@test.local
FIRST_ADMIN_PASSWORD=admin
ALLOW_WEAK_FIRST_ADMIN_PASSWORD=true
BCRYPT_ROUNDS=10
AUTO_IMPORT_DATA=true

# Envoi d'e-mails (confirmation de demande d'accès, code de réinitialisation
# de mot de passe). Pour Gmail, SMTP_PASSWORD doit être un mot de passe
# d'application, pas le mot de passe du compte (Compte Google > Sécurité >
# Validation en deux étapes > Mots de passe des applications).
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=ClimbClubCristal
EMAIL_FROM_ADDRESS=
